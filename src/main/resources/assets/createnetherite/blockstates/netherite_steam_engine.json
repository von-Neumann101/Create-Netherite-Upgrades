{
  "multipart": [
    { "when": { "face": "floor", "facing": "north" }, "apply": { "model": "createnetherite:block/netherite_steam_engine/block" } },
    { "when": { "face": "floor", "facing": "east" }, "apply": { "model": "createnetherite:block/netherite_steam_engine/block", "y": 90 } },
    { "when": { "face": "floor", "facing": "south" }, "apply": { "model": "createnetherite:block/netherite_steam_engine/block", "y": 180 } },
    { "when": { "face": "floor", "facing": "west" }, "apply": { "model": "createnetherite:block/netherite_steam_engine/block", "y": 270 } },
    { "when": { "face": "ceiling", "facing": "north" }, "apply": { "model": "createnetherite:block/netherite_steam_engine/block", "x": 180, "y": 180 } },
    { "when": { "face": "ceiling", "facing": "east" }, "apply": { "model": "createnetherite:block/netherite_steam_engine/block", "x": 180, "y": 270 } },
    { "when": { "face": "ceiling", "facing": "south" }, "apply": { "model": "createnetherite:block/netherite_steam_engine/block", "x": 180 } },
    { "when": { "face": "ceiling", "facing": "west" }, "apply": { "model": "createnetherite:block/netherite_steam_engine/block", "x": 180, "y": 90 } },
    { "when": { "face": "wall", "facing": "north" }, "apply": { "model": "createnetherite:block/netherite_steam_engine/block", "x": 90 } },
    { "when": { "face": "wall", "facing": "east" }, "apply": { "model": "createnetherite:block/netherite_steam_engine/block", "x": 90, "y": 90 } },
    { "when": { "face": "wall", "facing": "south" }, "apply": { "model": "createnetherite:block/netherite_steam_engine/block", "x": 90, "y": 180 } },
    { "when": { "face": "wall", "facing": "west" }, "apply": { "model": "createnetherite:block/netherite_steam_engine/block", "x": 90, "y": 270 } }
  ]
}
